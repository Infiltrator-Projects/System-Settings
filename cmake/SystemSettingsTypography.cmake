# System Settings can install independently of InfiltratorOS. Bundle the three
# pinned 1.010 MB Corpo Title faces required by its strict typography contract.
# The shared immutable source, filenames and digests belong to Libraries/Common.
include("${SYSTEM_SETTINGS_COMMON_DIR}/cmake/InfiltratrTypographyAssets.cmake")

set(SYSTEM_SETTINGS_FONT_DIR
    "${CMAKE_CURRENT_BINARY_DIR}/system-settings-fonts")
file(MAKE_DIRECTORY "${SYSTEM_SETTINGS_FONT_DIR}")
set(SYSTEM_SETTINGS_FONT_SOURCE_URL
    "https://raw.githubusercontent.com/${INFILTRATR_MB_CORPO_SOURCE_REPOSITORY}/${INFILTRATR_MB_CORPO_SOURCE_COMMIT}/${INFILTRATR_MB_CORPO_SOURCE_PATH}")

set(SYSTEM_SETTINGS_FONT_FILES "")
foreach(SYSTEM_SETTINGS_FONT_ROLE BRAND_REGULAR UI_BOLD UI_REGULAR)
    set(SYSTEM_SETTINGS_FONT_NAME
        "${INFILTRATR_MB_CORPO_${SYSTEM_SETTINGS_FONT_ROLE}_FILE}")
    set(SYSTEM_SETTINGS_FONT_SHA256
        "${INFILTRATR_MB_CORPO_${SYSTEM_SETTINGS_FONT_ROLE}_SHA256}")
    set(SYSTEM_SETTINGS_FONT_FILE
        "${SYSTEM_SETTINGS_FONT_DIR}/${SYSTEM_SETTINGS_FONT_NAME}")
    file(DOWNLOAD
        "${SYSTEM_SETTINGS_FONT_SOURCE_URL}/${SYSTEM_SETTINGS_FONT_NAME}"
        "${SYSTEM_SETTINGS_FONT_FILE}"
        EXPECTED_HASH "SHA256=${SYSTEM_SETTINGS_FONT_SHA256}"
        TLS_VERIFY ON
        STATUS SYSTEM_SETTINGS_FONT_DOWNLOAD_STATUS)
    list(GET SYSTEM_SETTINGS_FONT_DOWNLOAD_STATUS 0 SYSTEM_SETTINGS_FONT_DOWNLOAD_CODE)
    if(NOT SYSTEM_SETTINGS_FONT_DOWNLOAD_CODE EQUAL 0)
        list(GET SYSTEM_SETTINGS_FONT_DOWNLOAD_STATUS 1 SYSTEM_SETTINGS_FONT_DOWNLOAD_MESSAGE)
        message(FATAL_ERROR
            "Unable to obtain verified System Settings font ${SYSTEM_SETTINGS_FONT_NAME}: "
            "${SYSTEM_SETTINGS_FONT_DOWNLOAD_MESSAGE}")
    endif()
    list(APPEND SYSTEM_SETTINGS_FONT_FILES "${SYSTEM_SETTINGS_FONT_FILE}")
endforeach()

install(FILES ${SYSTEM_SETTINGS_FONT_FILES}
    DESTINATION "${CMAKE_INSTALL_DATADIR}/fonts/truetype/system-settings")
