ng static analysis
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    env:
+      PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
+    steps:
+      - name: Check out source and exact pinned Common
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          submodules: recursive
+
+      - name: Install Clang analysis dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y clang clang-tidy jq libgtk-4-dev libgeocode-glib-dev pkg-config
+
+      - name: Configure compilation database
+        run: |
+          cmake -S . -B build-static-analysis \
+            -DCMAKE_C_COMPILER=clang \
+            -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
+            -DBUILD_TESTING=ON \
+            -DSYSTEM_SETTINGS_WARNINGS_AS_ERRORS=ON
+
+      - name: Analyze System Settings translation units
+        shell: bash
+        run: |
+          set -euo pipefail
+          mapfile -t sources < <(
+            jq -r '.[].file' build-static-analysis/compile_commands.json \
+              | grep -v '/src/vendor/' \
+              | sort -u
+          )
+          if (( ${#sources[@]} == 0 )); then
+            echo "No System Settings translation units found in compilation database." >&2
+            exit 1
+          fi
+          printf 'Analyzing %d System Settings translation units.\n' "${#sources[@]}"
+          # Clang's DeprecatedOrUnsafeBufferHandling checker recommends C11
+          # Annex-K *_s functions that glibc deliberately does not implement
+          # and reports bounded snprintf/memcpy/memset/fprintf calls as errors.
+          # Keep the rest of the analyzer family strict, including unbounded
+          # strcpy, dead stores, nullability and lifetime diagnostics.
+          printf '%s\0' "${sources[@]}" \
+            | xargs -0 -r -n 20 clang-tidy \
+                -p build-static-analysis \
+                --checks='-*,clang-analyzer-*,-clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling' \
+                --warnings-as-errors='clang-analyzer-*,-clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling'
+
+  windows:
+    name: Windows build and test
+    runs-on: windows-latest
+    timeout-minutes: 30
+    defaults:
+      run:
+        shell: powershell
+    env:
+      PSExecutionPolicyPreference: RemoteSigned
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          submodules: recursive
+
+      - name: Configure
+        run: cmake -S . -B build -DBUILD_TESTING=ON -DSYSTEM_SETTINGS_WARNINGS_AS_ERRORS=ON
+
+      - name: Build
+        shell: powershell
+        run: |
+          $jobs = [Math]::Max([Environment]::ProcessorCount - 1, 1)
+          cmake --build build --config Release --parallel $jobs
+
+      - name: Test
+        run: ctest --test-dir build -C Release --output-on-failure
+
+  sanitizers:
+    name: Linux ASan and UBSan
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    env:
+      PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
+    steps:
+      - name: Check out source and exact pinned Common
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          submodules: recursive
+
+      - name: Install Linux UI dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y libgtk-4-dev libgeocode-glib-dev pkg-config xvfb dbus-x11
+
+      - name: Configure ASan and UBSan
+        run: |
+          cmake -S . -B build-sanitized \
+            -DCMAKE_BUILD_TYPE=Debug \
+            -DBUILD_TESTING=ON \
+            -DSYSTEM_SETTINGS_WARNINGS_AS_ERRORS=ON \
+            -DCMAKE_C_FLAGS="-fsanitize=address,undefined -fno-omit-frame-pointer" \
+            -DCMAKE_EXE_LINKER_FLAGS="-fsanitize=address,undefined" \
+            -DCMAKE_SHARED_LINKER_FLAGS="-fsanitize=address,undefined"
+
+      - name: Build sanitized targets
+        run: cmake --build build-sanitized --parallel "$(($(nproc)>1?$(nproc)-1:1))"
+
+      - name: Test non-GTK code with ASan, UBSan and leak detection
+        env:
+          ASAN_OPTIONS: detect_leaks=1:halt_on_error=1
+          UBSAN_OPTIONS: halt_on_error=1:print_stacktrace=1
+        run: ctest --test-dir build-sanitized --output-on-failure -E linux-shell
+
+      - name: Test GTK shell with ASan, UBSan and leak detection
+        env:
+          # GTK/Pango/fontconfig retain a few documented process-global
+          # caches. Suppress those exact external stacks instead of disabling
+          # LeakSanitizer for the entire application shell.
+          ASAN_OPTIONS: detect_leaks=1:halt_on_error=1
+          LSAN_OPTIONS: suppressions=${{ github.workspace }}/tests/lsan.supp:print_suppressions=1
+          UBSAN_OPTIONS: halt_on_error=1:print_stacktrace=1
+        run: ctest --test-dir build-sanitized --output-on-failure -R linux-shell
+
+  publish:
+    name: Publish exact tested release
+    needs: [linux, static-analysis, windows, sanitizers]
+    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
+    runs-on: ubuntu-24.04
+    concurrency:
+      group: system-settings-release
+      cancel-in-progress: false
+    permissions:
+      contents: write
+      actions: read
+    steps:
+      - name: Check out exact tested commit
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+
+      - name: Require releasable current main
+        id: classify
+        shell: bash
+        run: |
+          set -euo pipefail
+          expected="${{ github.sha }}"
+          test "$(git rev-parse HEAD)" = "$expected"
+
+          mapfile -t branch_refs < <(
+            git ls-remote --heads origin | awk '{print $2}' | LC_ALL=C sort
+          )
+          if [[ ${#branch_refs[@]} -ne 1 || "${branch_refs[0]}" != "refs/heads/main" ]]; then
+            printf 'Release requires exactly one remote branch, refs/heads/main. Found:\n' >&2
+            printf '  %s\n' "${branch_refs[@]}" >&2
+            exit 1
+          fi
+
+          version="$(tr -d '[:space:]' < VERSION)"
+          [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
+          tag="v$version"
+          candidate=true
+
+          current_main="$(git ls-remote origin refs/heads/main | awk '{print $1}')"
+          test -n "$current_main"
+          if [[ "$current_main" != "$expected" ]]; then
+            candidate=false
+            echo "Ignoring stale successful CI run $expected; main is now $current_main."
+          else
+            existing="$(git ls-remote origin "refs/tags/$tag" | awk '{print $1}')"
+            if [[ -n "$existing" && "$existing" != "$expected" ]]; then
+              echo "VERSION $version is already owned by $existing; current main $expected must use a new version before CI can be green." >&2
+              exit 1
+            fi
+          fi
+
+          echo "candidate=$candidate" >> "$GITHUB_OUTPUT"
+          echo "version=$version" >> "$GITHUB_OUTPUT"
+          echo "tag=$tag" >> "$GITHUB_OUTPUT"
+          echo "sha=$expected" >> "$GITHUB_OUTPUT"
+
+      - name: Download exact CI-tested release bytes
+        if: steps.classify.outputs.candidate == 'true'
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
+        with:
+          name: system-settings-release-assets
+          path: release-assets
+
+      - name: Seal exact tested bundle for publication
+        if: steps.classify.outputs.candidat